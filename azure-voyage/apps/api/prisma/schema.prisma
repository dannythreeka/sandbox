// 完整 schema（docs/03-data-model.md）。M1 起用；靜態內容以 contentId 字串引用。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── 帳號層 ─────────────────────────

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  displayName  String
  createdAt    DateTime    @default(now())
  worlds       GameWorld[]
}

// ───────────────────────── 世界層 ─────────────────────────

enum WorldStatus {
  ACTIVE
  VICTORY
  DEFEAT
  ABANDONED
}

model GameWorld {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  difficulty     String // "EASY" | "NORMAL" | "HARD"（zod 驗證於 API 邊界）
  contentVersion String
  seed           Int
  currentTick    Int         @default(0)
  status         WorldStatus @default(ACTIVE)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  guilds       Guild[]
  fleets       Fleet[]
  officers     Officer[]
  portStates   PortState[]
  portNotables PortNotable[]
  events       WorldEvent[]
  battles      Battle[]
  discoveries  DiscoveryRecord[]
  aiLogs       AiGenerationLog[]

  @@index([userId, status])
}

// ─────────────────────── 商會（勢力）───────────────────────

enum GuildKind {
  PLAYER
  NPC
  LOCAL // 港口在地勢力（影響力緩衝池，無實體艦隊）
}

model Guild {
  id      String    @id @default(cuid())
  worldId String
  world   GameWorld @relation(fields: [worldId], references: [id], onDelete: Cascade)
  kind    GuildKind
  name    String
  color   String
  gold    BigInt    @default(0)
  fame    Int       @default(0)

  // NPC 專用：AI 個性與當前策略（Zod: NpcPersona / NpcStrategy）
  aiPersona             Json?
  aiStrategy            Json?
  aiStrategyUpdatedTick Int?

  // 玩家商會專用：提督（艦長）個人成長（M27）——玩家角色本人的五維與經驗，
  // 區別於雇用的 Officer；NPC/在地勢力商會不使用，維持預設值即可。
  captainExp    Int @default(0)
  captainLead   Int @default(20)
  captainNav    Int @default(20)
  captainCombat Int @default(20)
  captainTrade  Int @default(20)
  captainLore   Int @default(20)

  fleets     Fleet[]
  influences PortInfluence[]

  @@unique([worldId, name])
  @@index([worldId, kind])
}

// ─────────────────────── 艦隊與船 ───────────────────────

enum FleetActivity {
  DOCKED
  SAILING
  ANCHORED
  EXPLORING
  IN_BATTLE
}

model Fleet {
  id           String        @id @default(cuid())
  worldId      String
  world        GameWorld     @relation(fields: [worldId], references: [id], onDelete: Cascade)
  guildId      String
  guild        Guild         @relation(fields: [guildId], references: [id], onDelete: Cascade)
  name         String
  activity     FleetActivity @default(DOCKED)
  posQ         Int // hex 座標（axial q,r）
  posR         Int
  dockedPortId String? // contentId，DOCKED 時必填
  route        Json? // Zod: Route
  food         Int           @default(0)
  water        Int           @default(0)
  morale       Int           @default(70)
  speedCarry   Float         @default(0) // M11：未消耗移動預算跨 tick 進位（逆風/暗礁防凍結）
  heading      Int? // M12：手動操舵航向（0–5）；與 route 互斥，null＝自動尋路模式或無方向

  ships    Ship[]
  officers Officer[]

  @@index([worldId, guildId])
  @@index([worldId, activity])
}

model Ship {
  id          String  @id @default(cuid())
  fleetId     String
  fleet       Fleet   @relation(fields: [fleetId], references: [id], onDelete: Cascade)
  shipClassId String // contentId
  name        String
  hull        Int
  sails       Int     @default(100)
  crew        Int
  isFlagship  Boolean @default(false)
  fitting     Json    @default("{}") // Zod: ShipFitting

  cargo CargoSlot[]

  @@index([fleetId])
}

model CargoSlot {
  id          String @id @default(cuid())
  shipId      String
  ship        Ship   @relation(fields: [shipId], references: [id], onDelete: Cascade)
  commodityId String // contentId
  quantity    Int
  avgBuyPrice Int

  @@unique([shipId, commodityId])
}

// ─────────────────────── 航海士 ───────────────────────

model Officer {
  id             String    @id @default(cuid())
  worldId        String
  world          GameWorld @relation(fields: [worldId], references: [id], onDelete: Cascade)
  fleetId        String?
  fleet          Fleet?    @relation(fields: [fleetId], references: [id], onDelete: SetNull)
  name           String
  portrait       String
  role           String? // "FIRST_MATE"|"NAVIGATOR"|"GUNNER"|"PURSER"|"LOOKOUT"
  stats          Json // Zod: OfficerStats
  skills         String[]
  loyalty        Int       @default(60)
  exp            Int       @default(0)
  salary         Int
  locationPortId String? // 待業時所在港（contentId）
  persona        Json? // AI 生成個性（一次生成後固化）

  @@index([worldId, fleetId])
  @@index([worldId, locationPortId])
}

// ─────────────────── 港口動態狀態與市場 ───────────────────

model PortState {
  id         String    @id @default(cuid())
  worldId    String
  world      GameWorld @relation(fields: [worldId], references: [id], onDelete: Cascade)
  portId     String // contentId
  prosperity Int       @default(50)
  facilities Json      @default("{}")

  market     MarketStock[]
  influences PortInfluence[]

  @@unique([worldId, portId])
}

model MarketStock {
  id           String    @id @default(cuid())
  portStateId  String
  portState    PortState @relation(fields: [portStateId], references: [id], onDelete: Cascade)
  commodityId  String // contentId
  stock        Int
  baseStock    Int
  price        Int
  priceHistory Json      @default("[]") // [{t,p}] 環形陣列 max 60

  @@unique([portStateId, commodityId])
}

model PortInfluence {
  id          String    @id @default(cuid())
  portStateId String
  portState   PortState @relation(fields: [portStateId], references: [id], onDelete: Cascade)
  guildId     String
  guild       Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)
  share       Decimal   @db.Decimal(5, 2)
  goodwill    Decimal   @default(0) @db.Decimal(10, 2)

  @@unique([portStateId, guildId])
}

// ─────────────────── 港口人物（M25，docs/17） ───────────────────

/** 每個港口配一位原創人物（港務總管/仕紳/漁夫…），可對話（DIALOGUE 共用）。 */
model PortNotable {
  id        String    @id @default(cuid())
  worldId   String
  world     GameWorld @relation(fields: [worldId], references: [id], onDelete: Cascade)
  portId    String // contentId
  name      String
  portrait  String
  archetype String
  persona   Json? // AI 生成個性（一次生成後固化：{description, greeting}）

  @@unique([worldId, portId])
}

// ─────────────────────── 事件 ───────────────────────

enum EventStatus {
  SCHEDULED
  ACTIVE
  RESOLVED
  EXPIRED
}

enum EventSource {
  RULE
  AI
}

model WorldEvent {
  id          String      @id @default(cuid())
  worldId     String
  world       GameWorld   @relation(fields: [worldId], references: [id], onDelete: Cascade)
  source      EventSource
  type        String
  status      EventStatus @default(SCHEDULED)
  triggerTick Int
  expireTick  Int?
  payload     Json // Zod: EventPayload（discriminated union）
  narrative   String?

  @@index([worldId, status, triggerTick])
}

// ─────────────────────── 海戰 ───────────────────────

enum BattleStatus {
  ONGOING
  PLAYER_WIN
  PLAYER_LOSE
  FLED
}

model Battle {
  id          String       @id @default(cuid())
  worldId     String
  world       GameWorld    @relation(fields: [worldId], references: [id], onDelete: Cascade)
  // 玩家艦隊 id（bug 修復：讓「重新連線時我的艦隊是否還在一場進行中的海戰裡」可查，
  // 不必再拿艦隊船隻 id 去逐一比對 state.units；舊資料/系統戰鬥可能沒有，留 nullable）。
  fleetId     String?
  status      BattleStatus @default(ONGOING)
  seed        Int
  round       Int          @default(1)
  startedTick Int
  state       Json // Zod: BattleState（完整棋盤快照）
  actionLog   Json         @default("[]")

  @@index([worldId, status])
  @@index([worldId, fleetId, status])
}

// ─────────────────────── 發現物 ───────────────────────

model DiscoveryRecord {
  id          String    @id @default(cuid())
  worldId     String
  world       GameWorld @relation(fields: [worldId], references: [id], onDelete: Cascade)
  discoveryId String // contentId
  foundTick   Int
  registered  Boolean   @default(false)
  narrative   String? // AI 圖鑑文本（一次生成後固化）

  @@unique([worldId, discoveryId])
}

// ─────────────────────── AI 稽核 ───────────────────────

model AiGenerationLog {
  id           String    @id @default(cuid())
  worldId      String
  world        GameWorld @relation(fields: [worldId], references: [id], onDelete: Cascade)
  kind         String // "EVENT_GEN"|"NPC_STRATEGY"|"DIALOGUE"|"NARRATIVE"|"PERSONA"
  model        String
  inputTokens  Int
  outputTokens Int
  ok           Boolean
  error        String?
  createdAt    DateTime  @default(now())

  @@index([worldId, kind, createdAt])
}
