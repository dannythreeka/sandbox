{
  "extends": "@azure-voyage/tsconfig/base.json",
  "compilerOptions": {
    "outDir": "dist",
    "baseUrl": ".",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strictPropertyInitialization": false,
    "declaration": false,
    "incremental": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
