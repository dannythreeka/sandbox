# PostgreSQL（docker compose up -d postgres 的預設值）
DATABASE_URL="postgresql://voyage:voyage@localhost:5432/azure_voyage?schema=public"

# Redis（M0 尚未使用，M2 起 tick 佇列需要）
REDIS_URL="redis://localhost:6379"

# JWT 簽章密鑰（正式環境務必更換）
JWT_SECRET="dev-only-secret-change-me"

# AI 層（M8 起使用；=false 時全走規則 fallback，開發不需要 API key）
AI_ENABLED=false
ANTHROPIC_API_KEY=

# 服務埠
API_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001
